// Where the money is, in three currencies, and who is paid. Euros and pounds are
// cash here: they are declared in `std` as currencies, so spending them realizes
// no capital gain, and `available` counts them. The foreign account reporting
// check is the running-maximum trick described below.
//
// Money sits in accounts. Whom it goes to is a party, and what it is for is a purpose: there are no
// income, expense or equity accounts, so a merchant carries the purpose of what it sells
// (`entity bvg #transport`), and a payment to no one in particular says its purpose itself
// (`girokonto -> ? 53.72 EUR #groceries`).

// ─── United States ──────────────────────────────────────────────────────────

account us-checking : bank
account us-savings  : bank
account us-401k : 401k
  employer acme

account visa : credit-card

/// 31,120.40 USD at 4.53% at the start of the year; 420.00 USD a month.
account student-loan : loan
  rate     4.53%
  maturity 2032-06-30


// ─── Germany and the United Kingdom ─────────────────────────────────────────
//
// A US person with foreign accounts worth more than 10,000 USD in total at any
// time in the year files an FBAR (FinCEN Form 114, due April 15, extended to
// October 15) listing each account's highest balance in dollars. Axiom has no
// running maximum, so each account keeps one in a tally: `always` fires after
// each change, and `count max(v - tally(...), empty)` adds only the amount by
// which today's value passes the highest so far. The tally is then the highest
// value. A tally has one name per law, so it takes one law per account.

/// The current account (Girokonto): salary arrives here and rent leaves.
account girokonto : bank
  holds EUR
  /// Keeps the highest value in dollars this account reached in the year, at the rate of the day,
  /// in a tally the yearly check below adds up (FinCEN 114 lists each account's highest balance).
  ///
  /// To fix: a rate is missing when the value cannot be computed: add a price line for the day.
  law fbar-max
    always
    let v = value(balance, USD)
    count max(v - value(tally(fbar-girokonto), USD), empty) as fbar-girokonto

/// A high-interest savings account (Tagesgeld).
account tagesgeld : bank
  holds EUR
  /// Keeps the highest value in dollars this account reached in the year, at the rate of the day,
  /// in a tally the yearly check below adds up (FinCEN 114 lists each account's highest balance).
  ///
  /// To fix: a rate is missing when the value cannot be computed: add a price line for the day.
  law fbar-max
    always
    let v = value(balance, USD)
    count max(v - value(tally(fbar-tagesgeld), USD), empty) as fbar-tagesgeld

/// Where German pay and interest pass: they arrive here gross and leave as the tax, the contributions and the net pay
/// to the girokonto, the way a payslip reads. The employer withholds before it pays, so the girokonto never holds the
/// gross: the running maximum below and the currency disposals read what an account holds. It is empty at the end of the day.
account de-clearing : bank
  holds EUR

/// The rent deposit (Mietkaution): three months of base rent, blocked in a
/// savings account in my name until the lease ends.
account kaution : bank
  holds EUR
  liquidity 700d
  /// Keeps the highest value in dollars this account reached in the year, at the rate of the day,
  /// in a tally the yearly check below adds up (FinCEN 114 lists each account's highest balance).
  ///
  /// To fix: a rate is missing when the value cannot be computed: add a price line for the day.
  law fbar-max
    always
    let v = value(balance, USD)
    count max(v - value(tally(fbar-kaution), USD), empty) as fbar-kaution

/// A Wise account in pounds, for the trip. It is a foreign account too.
account wise : bank
  holds GBP
  /// Keeps the highest value in dollars this account reached in the year, at the rate of the day,
  /// in a tally the yearly check below adds up (FinCEN 114 lists each account's highest balance).
  ///
  /// To fix: a rate is missing when the value cannot be computed: add a price line for the day.
  law fbar-max
    always
    let v = value(balance, USD)
    count max(v - value(tally(fbar-wise), USD), empty) as fbar-wise


// ─── What money is for ──────────────────────────────────────────────────────
//
// std and `us` declare rent, groceries, dining, utilities, transport, phone, travel, wages,
// interest-income and the tax purposes. The rest are this book's.

purpose subscriptions : spending
purpose shopping : spending
purpose moving : spending
purpose conference : spending
purpose sightseeing : spending
purpose payroll-tax : spending
purpose sozialabgaben : spending

/// What conversions and card fees cost. Written by hand: a conversion with a spread, not a fee, has no line
/// here. A fee leg that carries it is a cost of the exchange, so it adds to what the money bought cost.
purpose fees : spending

/// Pay set aside before tax into the 401(k) (IRC §402(e)(3)): a deferral counts toward the yearly limit, and is
/// counted as pre-tax and taken back out of income. The pay stub says it: gross pay in, then the deferral.
purpose payroll-deferral : pre-tax-deferral
  law payroll-deferral
    on flow
    count amount as pretax
    count -amount as total-income

/// Groceries, in dollars in San Francisco and in euros in Berlin: one budget, in dollars.
budget groceries 550 USD monthly


// ─── Employers and payees ───────────────────────────────────────────────────

entity acme : employer

/// The German employer: what it pays is foreign wages (`us/abroad` counts them for the exclusion).
entity employer-gmbh : foreign-employer

entity ssa #payroll-tax
entity edd #payroll-tax
entity sozialversicherung #sozialabgaben

/// What converting costs: Wise's fees, and the card's fee for a foreign transaction.
entity wise-fees #fees
entity card-issuer #fees

entity landlord-sf #rent
entity mohela #student-loan-interest
entity sea-freight #moving
entity lufthansa #travel
entity london-hotel #travel
entity hausverwaltung #rent
entity bvg #transport
entity netflix #subscriptions
entity apple #subscriptions
entity us-phone #subscriptions
entity pret-a-manger #dining
entity tfl #transport
entity design-conf #conference
entity borough-market #dining
entity british-museum #sightseeing
entity dishoom #dining
entity liberty #shopping
entity the-pub #dining
entity black-cab #transport
entity cafe #dining
entity heathrow-express #transport
entity ryanair #travel


// ─── Foreign accounts: the yearly total ─────────────────────────────────────

/// FBAR: the highest values of the year, account by account, added up. Each
/// value is at the rate of the day, where the Treasury uses one year-end rate.
///
/// To fix: file FinCEN 114 by April 15 listing each foreign account's highest balance (the tallies
/// `fbar-girokonto` and the others in `axiom tax`).
law fbar
  each year
  let total = value(tally(fbar-girokonto), USD) + value(tally(fbar-tagesgeld), USD) + value(tally(fbar-kaution), USD) + value(tally(fbar-wise), USD)
  count total as fbar-aggregate
  warn total <= 10_000 USD "foreign accounts passed 10,000 USD: file FinCEN 114 (FBAR) by April 15"
