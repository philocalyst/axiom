// The original statement rows remain in the journal. These agreements supply
// the forward schedule from the 2025-12-31 closing balances.

/// The remaining mortgage term begins with the independently stated balance.
contract mortgage-payment with lender
  loan 406_692.02 USD on 2025-12-31 at 5.875% over 27y6m for house
  monthly on 1 from joint-checking
  from 2026-01-01
  also -> escrow 705 USD #contribution

/// The remaining car note begins with the year-end lender statement.
contract car-payment with honda-finance
  loan 16_976.91 USD on 2025-12-31 at 4.9% over 30m for crv
  monthly on 5 from joint-checking
  from 2026-01-01

/// County tax installments and the annual house-policy renewal are paid from
/// the servicer's escrow account.
contract property-tax-spring with county
  3_300 USD yearly on 04-10 from escrow #property-tax
  from 2026-04-10

contract property-tax-fall with county
  3_300 USD yearly on 11-10 from escrow #property-tax
  from 2026-11-10

contract home-insurance with homeguard
  1_870 USD yearly on 06-20 from escrow #insurance of house
  from 2026-06-20

/// The remaining 529 tuition payment.
contract riley-tuition with st-annes-school
  4_800 USD yearly on 01-10 from riley-529 #education
  from 2026-01-10

/// Regular household and payroll commitments continue at the written 2025
/// rates. The journal holds the exact 2025 stubs; the contracts cover 2026 on.
contract alex-pay : employment with acme
  employee me
  employer acme
  5_750 USD twice monthly on 15, last into joint-checking #wages
  alex-401k 575 USD #household-deferral
  hsa 250 USD
  blue-shield 212.50 USD #pretax-benefit
  dcfsa 208.33 USD
  irs 692 USD #federal-tax
  ftb 285 USD #state-tax
  ssa 388.56 USD #payroll-tax
  edd 60.95 USD #state-disability
  joint-checking ...
  from 2026-01-01
  also acme -> alex-401k 40% of ([alex-401k] up to 10% of amount) #contribution

contract jordan-pay : employment with bluefin
  employee jordan
  employer bluefin
  3_803.08 USD every 2w on friday into joint-checking #wages
  jordan-401k 228.18 USD #household-deferral
  irs 330 USD #federal-tax
  ftb 126 USD #state-tax
  ssa 290.93 USD #payroll-tax
  edd 45.64 USD #state-disability
  joint-checking ...
  from 2026-01-02
  also bluefin -> jordan-401k 50% of ([jordan-401k] up to 6% of amount) #contribution

/// The 2026 bonus uses the same gross and supplemental withholding rates as
/// the 2025 bonus record.
contract alex-bonus : employment with acme
  employee me
  employer acme
  12_000 USD yearly on 03-14 into joint-checking #wages
  alex-401k 1_200 USD #household-deferral
  irs 2_640 USD #federal-tax
  ftb 1_227.60 USD #state-tax
  ssa 918 USD #payroll-tax
  edd 144 USD #state-disability
  joint-checking ...
  from 2026-03-14
  also acme -> alex-401k 40% of ([alex-401k] up to 10% of amount) #contribution
