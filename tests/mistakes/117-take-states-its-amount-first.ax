// MISTAKE: a `<-` line states its amount after the end it takes from, and here it stands before the arrow.
base USD
use std

commodity VTI : security
  precision 0

account assets/brokerage : brokerage
account assets/checking : bank
account assets/savings  : bank

entity acme : employer

opening 2025-12-31
  checking 3_000 USD
  brokerage 10 VTI basis 2_800 USD since 2024-03-01

2026-01-16 checking 3_200 USD <- acme
