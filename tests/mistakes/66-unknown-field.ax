// MISTAKE: `owner.aeg` for `owner.age`.
base USD
use std
use us/401k

account assets/checking : bank
account equity/opening

entity me : person
  born   1988-04-12
  filing single
  lives  us

account assets/retirement : 401k
  law adult-only
    on in
    require owner.aeg >= 18y "owner is a minor"

2025-12-31 equity/opening -> checking 1_000 USD
2026-01-08 checking -> retirement 500 USD
