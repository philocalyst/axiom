// MISTAKE: a sale from an account with no lot policy, holding two lots that differ.
base USD
use std

commodity VTI : fund
  precision 0

account assets/brokerage
account assets/checking : bank
account equity/opening

2025-12-31 checking        <- equity/opening 5_000 USD
2026-01-22 checking        -> brokerage      7 VTI     @ 285.714 USD
2026-02-18 checking        -> brokerage      5 VTI     @ 300.00 USD
2026-03-02 brokerage 8 VTI -> checking                 @ 300.00 USD
