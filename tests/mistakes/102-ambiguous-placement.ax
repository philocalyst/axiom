// MISTAKE: two employers before the name of a 401(k). Each could be the owner or the `employer`, and nothing
// settles which: placement never takes the first slot that fits. A role line says which.
base USD
use std
use us/401k

entity fidelity : org
entity bluefin : employer
entity acme : employer

account bluefin/acme/401k at fidelity

opening 2026-01-01
  bluefin/acme/401k 5_000 USD
