// MISTAKE: rent paid with the wrong account; checking goes below zero.
base USD
use std

account assets/checking : bank
account assets/savings : bank
account expenses/rent
account equity/opening

entity landlord : org
  via expenses/rent

2025-12-31 equity/opening -> checking 800 USD
2025-12-31 equity/opening -> savings 9_000 USD
2026-01-01 checking -> landlord 1_800 USD
