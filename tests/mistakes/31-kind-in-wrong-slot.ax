// MISTAKE: an account given a commodity kind (`fund`, which is for commodities).
base USD
use std

commodity VTI : fund
  precision 0

account assets/brokerage : fund
account assets/checking : bank
account equity/opening

2025-12-31 equity/opening -> checking 3_000 USD
2026-01-22 checking 2_000 USD -> brokerage 7 VTI
