// MISTAKE: the payment of February was written with 2,000.00 USD of a 3,650.63 USD payment, and the lender's statement is what the book holds. The difference is the principal that line left unpaid.
base USD
use std

entity bank : lender
account checking : bank
asset condo : property

opening 2026-01-01
  checking 900_000 USD

contract mortgage with bank
  loan 120_000 USD on 2026-01-15 at 6% over 3y for condo
  monthly on 1 from checking
  from 2026-02-01
  until 2026-02-28

2026-01-15 mortgage

2026-02-01 mortgage 2_000 USD
2026-02-02 mortgage = 118_600.00 USD
