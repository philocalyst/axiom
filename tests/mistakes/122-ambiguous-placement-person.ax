// MISTAKE: a person before the name of a 529 plan. A person could be its owner or its beneficiary, and nothing settles which:
// placement never takes the first slot that fits. A role line says which.
base USD
use std
use us/529

entity fidelity : org
entity jordan : person

account jordan/529-plan at fidelity

opening 2026-01-01
  jordan/529-plan 5_000 USD
