// MISTAKE: the lot selector names a purchase date that does not exist.
base USD
use std

commodity VTI : fund
  precision 0

account assets/brokerage : broker
account assets/checking : bank
account equity/opening

2025-12-31 equity/opening -> checking 5_000 USD
2026-01-22 checking 2_000 USD -> brokerage 7 VTI
2026-02-18 checking 1_500 USD -> brokerage 5 VTI
2026-03-02 brokerage[2026-01-23] 3 VTI -> checking 900 USD
