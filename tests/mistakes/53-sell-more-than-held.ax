// MISTAKE: selling 10 VTI when only 7 are held.
base USD
use std

commodity VTI : fund
  precision 0

account assets/brokerage : broker
account assets/checking : bank
account equity/opening

2025-12-31 checking         <- equity/opening 3_000 USD
2026-01-22 checking         -> brokerage      7 VTI     @ 285.714 USD
2026-03-02 brokerage 10 VTI -> checking                 @ 305.00 USD
