// MISTAKE: the person lives in the US but `filing` is not set, and 2025 has ended.
base USD
use std
use us

entity me : person
  born   1988-04-12
  lives  us

account assets/checking : bank
account income/salary : wages
account expenses/taxes/federal : federal-tax
entity acme : employer
  via income/salary

2025-01-15 me <- acme 8_000 USD
  -> taxes/federal 880 USD
  -> checking      ...
