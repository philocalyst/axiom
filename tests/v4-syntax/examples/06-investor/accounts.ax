// Native v4 holdings and counterparties. Purpose and party identify a flow's
// meaning; there are no income, expense, or equity chart accounts.

// Project-specific recognition tags.
purpose staking : income
purpose misc : spending
purpose network-fee : spending
purpose payroll-tax : tax-paid

// The owner records the one replacement-share adjustment that Axiom cannot
// infer in this project. The source is retained pending native carry semantics.
kind wash-adjustment : asset

// Income counterparties say what they pay. Employers and built-in issuers also
// carry their purposes through std.
kind dividend-payer : org
  pays dividend
kind interest-payer : org
  pays interest-income
kind staking-payer : org
  pays staking

/// Pay set aside for the employee stock purchase plan stays restricted until
/// shares are bought for the owner.
entity espp : envelope

// Traded units and their native precision.
commodity VTI : fund
  name "Vanguard Total Stock Market ETF"
  precision 4
commodity VXUS : fund
  name "Vanguard Total International Stock ETF"
  precision 4
commodity BND : fund
  name "Vanguard Total Bond Market ETF"
  precision 4
commodity VNQ : fund
  name "Vanguard Real Estate ETF"
  precision 4
commodity SCHH : fund
  name "Schwab U.S. REIT ETF"
  precision 4
commodity MSFT : stock
  precision 4
commodity UNH : stock
  precision 4
/// Fastenal split 2-for-1 on 2025-05-22; prices before the split use the old units.
commodity FAST : stock
  name "Fastenal"
  precision 4
commodity NWND : stock
  name "Northwind Systems"
  precision 4
commodity BTC : crypto
  precision 8
commodity ETH : crypto
  precision 8

// Cash, retirement, brokerage, and self-custody places.
account checking : bank
account savings : bank
account espp-cash : cash
account retirement : 401k
  employer northwind
/// HIFO relief minimizes realized gains on sales without a named lot.
account fidelity : brokerage
  select hifo
/// Moved lots retain their purchase day and basis; this account uses FIFO.
account schwab : brokerage
  select fifo
account etrade : brokerage
  select fifo
account coinbase : brokerage
  holds BTC, ETH, USD
  select fifo
account wallet : brokerage
  holds ETH
  select fifo
account wash-sale : wash-adjustment

// Counterparties. A party's kind or declared purpose assigns the ordinary
// reason for payments and receipts.
entity northwind : employer
entity landlord : landlord
entity utility-co : utility
entity grocer : grocer
entity cafe #dining
entity misc-vendor #misc
entity dividend-source : dividend-payer
entity interest-source : interest-payer
entity staking-source : staking-payer
entity payroll-office #payroll-tax
entity network-fees #network-fee
