// Where the money is, who it comes from, and what each kind of place means for
// tax. The rules themselves are in tax.ax.

// ─── Kinds this project needs ───────────────────────────────────────────────

/// Money a client owes for an invoice sent and not yet paid. One place per
/// client, so each client's balance is one line.
kind receivable : asset
  liquidity 45d

  /// Cash method (IRC §446): an invoice is income when the money arrives, not
  /// when it is sent. Everything that leaves a receivable place counts,
  /// including what a processor kept as its fee: the fee is a deductible
  /// expense of its own. A write-off is not a receipt.
  ///
  /// This law lives in the kind, not at the top of the project: a top-level
  /// law does not see a flow between two places of the same owner.
  law count-receipts
    on out
    when not to is bad-debt
    count amount as gross-receipts

/// A SEP-IRA: pre-tax money that comes out taxed as income. There is no shipped
/// system for it, so the limit and the deduction are in tax.ax.
kind sep-ira : tax-deferred
  liquidity 3d

  /// Contributions made from a bank account are what the year-end law caps and
  /// deducts. Growth and the opening balance do not come from a bank.
  law count-contributions
    on in
    when from is bank
    count amount as sep-contributions

  /// Everything that comes out of a SEP-IRA is ordinary income (IRC §408(d)).
  /// It is pre-tax money, so all of it is gain.
  law count-distributions
    on gain
    when gain > empty
    when not to is tax-deferred
    count gain as distributions
    count gain as agi

  /// Money taken out before age 59½ owes an extra 10% (IRC §72(t)).
  law early-withdrawal
    on gain
    when gain > empty
    when not to is tax-deferred
    require owner.age >= 59y6m else owe 10% * gain to irs as early-withdrawal-penalty "SEP-IRA withdrawal before age 59½"

// A mile is a unit like any other. The deduction is what a mile is worth on the
// day, so the rate goes in the price file.
commodity MI
  name "mile"
  precision 0


// ─── Banks, card, retirement ────────────────────────────────────────────────

/// Business checking. Client money lands here.
account assets/bank/business-checking : bank

/// Personal checking, funded by an owner's draw each month.
account assets/bank/personal-checking : bank

/// Taxes are set aside here: a quarter of every payment goes in when it arrives,
/// and the estimated payments come out.
account assets/bank/tax-vault : bank

/// SEP-IRA at the custodian.
account assets/retirement/sep : sep-ira

/// The business card, paid in full every month.
account liabilities/business-card : credit-card

// One receivable per client.
account assets/receivable/brightwave  : receivable
account assets/receivable/fernhill    : receivable
account assets/receivable/orbit-labs  : receivable
account assets/receivable/delta-rugs  : receivable
account assets/receivable/northpeak   : receivable


// ─── Income and equity ──────────────────────────────────────────────────────

/// Fees for design work. Recognized when invoiced; taxed when paid (tax.ax).
account income/design
account income/interest : interest
account income/growth   : gains
account income/rewards
account equity/opening

/// Miles driven for work. Only the deduction matters, so the log is a source of
/// miles like an income place is a source of dollars.
account equity/odometer


// ─── Business expenses ──────────────────────────────────────────────────────

/// Everything under here is an ordinary business expense (IRC §162), deducted in
/// the year it is paid or charged. One law covers the subtree.
account expenses/business
  law deductible
    on in
    count amount as business-expenses

/// Subscriptions are budgeted: 113.19 USD a month is the standing total, and
/// an annual plan on top of it (Dropbox) goes over.
account expenses/business/software
  budget 130 USD monthly
account expenses/business/insurance
account expenses/business/equipment
account expenses/business/education
account expenses/business/travel
account expenses/business/printing
account expenses/business/fonts
account expenses/business/hosting

/// Card annual fee, Stripe's cut, and wire fees.
account expenses/business/fees

/// An invoice that was never paid. Under the cash method its income was never
/// counted, so there is nothing to deduct: this is outside expenses/business.
account expenses/bad-debt

/// Client meals: half deductible.
account expenses/meals
  law half-deductible
    on in
    count amount * 50% as business-expenses

/// Business miles at the standard rate: the deduction is what the miles are
/// worth in dollars on the day.
account expenses/mileage
  law standard-mileage
    on in
    count value(amount, USD) as business-expenses

/// The share of the home used for work (150 of 1,000 sq ft) applies to every
/// cost of the home.
account expenses/home
  law home-office
    on in
    count amount * office-share[year] as business-expenses

account expenses/home/rent
account expenses/home/utilities
account expenses/home/internet
account expenses/home/insurance

/// The phone is 60% business.
account expenses/phone
  law phone-share
    on in
    count amount * 60% as business-expenses

/// Health insurance premiums: an adjustment to income, not a business expense.
account expenses/health-insurance
  law self-employed-health
    on in
    count amount as health-premiums

/// Groceries and eating out.
account expenses/food
  budget 550 USD monthly

account expenses/food/groceries
account expenses/food/dining
account expenses/transport

/// Estimated tax payments. A place of kind `federal-tax` counts what arrives as
/// tax already paid.
account expenses/taxes/federal : federal-tax


// ─── Clients and vendors ────────────────────────────────────────────────────

/// A client. An entity written where a place is expected stands for its `via`
/// place: `income/design -> brightwave` is an invoice, `brightwave -> business`
/// is the payment.
entity brightwave : org
  via assets/receivable/brightwave

entity fernhill : org
  via assets/receivable/fernhill

entity orbit-labs : org
  via assets/receivable/orbit-labs

entity delta-rugs : org
  via assets/receivable/delta-rugs

entity northpeak : org
  via assets/receivable/northpeak

entity adobe : org
  via expenses/business/software
entity figma : org
  via expenses/business/software
entity notion : org
  via expenses/business/software
entity google : org
  via expenses/business/software
entity freshbooks : org
  via expenses/business/software
entity dropbox : org
  via expenses/business/software
entity hiscox : org
  via expenses/business/insurance
entity apple : org
  via expenses/business/equipment
entity ixdf : org
  via expenses/business/education
entity config : org
  via expenses/business/education
entity monotype : org
  via expenses/business/fonts
entity squarespace : org
  via expenses/business/hosting
entity alaska-air : org
  via expenses/business/travel
entity sf-hotel : org
  via expenses/business/travel
entity lyft : org
  via expenses/business/travel

entity landlord : org
  via expenses/home/rent
entity pge : org
  via expenses/home/utilities
entity comcast : org
  via expenses/home/internet
entity statefarm : org
  via expenses/home/insurance
entity tmobile : org
  via expenses/phone
entity bluecross : org
  via expenses/health-insurance
entity trader-joes : org
  via expenses/food/groceries
entity safeway : org
  via expenses/food/groceries


// ─── Codes ──────────────────────────────────────────────────────────────────

/// An invoice number links the invoice to every payment against it.
code inv-*
  on receivable
