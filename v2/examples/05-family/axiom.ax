// A family: two adults filing jointly and one child. Calendar year 2025.
//
// The folders are constraints: journal/2025/03.ax holds March 2025 only.
// journal/2024/12.ax holds the opening balances, dated 2024-12-31.

base USD

use std
use us/401k
use us/529
use us/hsa

/// Alex, 37, the primary taxpayer. Everything the household shares is owned by
/// `me`, because Axiom has one owner per place and one tax return per owner; see
/// README.md. `children` is read by laws.ax for the child tax credit.
entity me : taxpayer
  born     1988-02-10
  filing   joint
  children 1
  lives    us/ca

/// Jordan, 37. Owns only a 401(k), so the 401(k) deferral limit is Jordan's own.
/// Everything else in Jordan's paycheck lands in places `me` owns, which is how
/// the joint return sees one income (see README.md).
entity jordan : taxpayer
  born     1987-06-21
  filing   joint
  children 0
  lives    us/ca

/// Riley, five, the 529 plan's beneficiary and the dependent.
entity riley : person
  born     2019-08-22
