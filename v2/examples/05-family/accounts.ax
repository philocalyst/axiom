// Kinds, commodities, places and people of the household. What a place means for
// tax comes from its kind: `us` counts itemized deductions, pre-tax pay and
// withholding by kind, so almost nothing here is a law.

// ─── Kinds this project needs ───────────────────────────────────────────────

/// A dependent-care FSA (IRC §129): pre-tax pay set aside for care of a child
/// under 13, capped per household. What pays a place of kind `childcare` comes
/// out tax-free; anything else is income. `us` takes the deferral out of pay.
kind dependent-care-fsa : tax-deferred
  basis zero
  liquidity 5d
  pays childcare

  /// Employer-provided dependent-care benefits are excluded from income up to
  /// 5,000 USD for the household (IRC §129(a)(2)). This deferral took the year
  /// over the cap, and the excess is wages.
  ///
  /// To fix: lower the election at the next open enrollment.
  law contribution-limit
    on in
    when from is wages
    count amount as dcfsa-contributions
    require tally(dcfsa-contributions) <= dependent-care-limit[year] "dependent-care FSA over the yearly cap"

/// Care that a dependent-care FSA may pay.
kind childcare : expense

commodity HOME : real-estate
  name "the house"
  precision 0

commodity CRV : good
  name "the car"
  precision 0


// ─── Cash and everyday accounts ─────────────────────────────────────────────

/// The joint checking account, and the savings beside it: the household's.
account assets/bank/joint-checking : bank
  owner family
account assets/bank/joint-savings : bank
  owner family

/// Money the servicer holds to pay property tax and insurance on the house. It is
/// the family's and not spendable: `available` counts it as held.
account assets/escrow : escrow
  owner family


// ─── Retirement, health and education accounts ──────────────────────────────

/// Alex's 401(k): `me` owns it, so its deferral limit is Alex's own.
account assets/retirement/alex-401k : 401k
  employer acme

/// Jordan's 401(k), and Jordan's own limit.
account assets/retirement/jordan-401k : 401k
  owner    jordan
  employer bluefin

/// The family HSA, in Alex's name: 8,550 USD for 2025, employer money included.
account assets/hsa : hsa
  coverage family

account assets/dcfsa : dependent-care-fsa

/// Riley's 529 plan, held by the household. What was put in is its basis, whether
/// it came from checking or from a grandparent; the market's growth arrives through
/// `market` and has none.
account assets/education/riley-529 : 529-plan
  owner       family
  beneficiary riley


// ─── Things owned ───────────────────────────────────────────────────────────

/// The house, one unit whose value is a price in prices/home.ax. Its cost is its
/// basis. A main home is held for the family's own use: a loss on it is not
/// deductible, and part of a gain is excluded when it is sold.
account assets/house : home
  holds HOME
  owner family

account assets/vehicle/crv : vehicle
  holds CRV
  owner family


// ─── Debts ──────────────────────────────────────────────────────────────────

/// 420,000 USD at 5.875% for thirty years, first payment 2023-08-01.
account liabilities/mortgage : mortgage
  rate     5.875%
  maturity 2053-07-01
  owner    family

/// 32,000 USD at 4.9% for sixty months, first payment 2023-07-05.
account liabilities/car-loan : loan
  rate     4.9%
  maturity 2028-06-05
  owner    family

/// One card for everyday spending, paid in full on the 25th.
account liabilities/card : credit-card
  owner family


// ─── Income and equity ──────────────────────────────────────────────────────

account income/alex-salary   : wages
account income/jordan-salary : wages
  owner jordan
account income/interest : interest
account income/employer-match
account income/employer-hsa
account income/gifts
account income/rewards


// ─── Expenses ───────────────────────────────────────────────────────────────

/// Groceries and eating out.
account expenses/food
  budget 1_300 USD monthly

account expenses/food/groceries
account expenses/food/dining

/// The interest on the mortgage, the property tax and gifts to charity are
/// deducted if the family itemizes: `us` counts what arrives at a place of these
/// kinds, and takes the larger of that and the standard deduction.
account expenses/housing/mortgage-interest : mortgage-interest
account expenses/housing/property-tax : property-tax
account expenses/housing/home-insurance
account expenses/charity : charity

account expenses/utilities
account expenses/subscriptions
account expenses/shopping
account expenses/kids
account expenses/travel
account expenses/fuel
account expenses/auto/insurance
account expenses/auto/loan-interest
account expenses/auto/repairs

/// Care for Riley: a place of kind `childcare`, so the FSA may pay it.
account expenses/childcare : childcare

/// School: a place of kind `education`, so the 529 plan may pay it.
account expenses/tuition : education

/// Medical costs: a place of kind `medical`, so the HSA may pay them.
account expenses/medical : medical

/// Medical, dental and vision premiums, taken from pay before tax: pay counts
/// whole, and `us` takes what goes here back out of it.
account expenses/health-premium : pretax-benefit

/// Tax withheld from pay. A place of kind `federal-tax` or `ca-tax` counts what
/// arrives as tax paid for the year.
account expenses/taxes/federal : federal-tax
account expenses/taxes/state   : ca-tax
account expenses/taxes/payroll

/// California SDI is a state tax, and deductible with the rest up to the cap. The
/// account is the household's so that what it counts lands in the joint return.
account expenses/taxes/sdi
  owner family
  law itemize-sdi
    on in
    count amount as salt

/// The balance due on last year's California return, paid in April: state income
/// tax paid in 2025, deductible in 2025 whatever year it was for.
account expenses/taxes/state-prior
  owner family
  law itemize-state
    on in
    count amount as salt


// ─── Employers and others ───────────────────────────────────────────────────

entity acme : employer
  via income/alex-salary
entity bluefin : employer
  via income/jordan-salary

/// The servicer. A payment to it is split into principal, interest and escrow.
entity lender : org
  via liabilities/mortgage
entity honda-finance : org
  via liabilities/car-loan

entity county : org
  via expenses/housing/property-tax
entity homeguard : org
  via expenses/housing/home-insurance
entity costco, trader-joes : org
  via expenses/food/groceries
entity shell : org
  via expenses/fuel
entity amazon : org
  via expenses/shopping
entity target : org
  via expenses/kids
entity pge, comcast, verizon : org
  via expenses/utilities
entity netflix, spotify : org
  via expenses/subscriptions
entity statefarm : org
  via expenses/auto/insurance
entity brake-shop : org
  via expenses/auto/repairs
entity st-annes-parish, food-bank : org
  via expenses/charity
entity little-sprouts, kids-club : org
  via expenses/childcare
entity st-annes-school : org
  via expenses/tuition
entity dr-chen, smile-dental, cvs, er-clinic : org
  via expenses/medical

/// Riley's grandmother. Money from her lands in the 529 plan.
entity grandma : org
  via income/gifts


// ─── Codes ──────────────────────────────────────────────────────────────────

/// A payment to the servicer, tied to its statement.
code mortgage-*
  on mortgage

code 529-*
  on 529-plan


// ─── Figures ────────────────────────────────────────────────────────────────

// The dependent-care FSA cap (IRC §129(a)(2)). 2026 rises to 7,500 (P.L. 119-21).
param dependent-care-limit
  2024 5_000 USD
  2025 5_000 USD
  2026 7_500 USD
