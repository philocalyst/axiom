// MISTAKE: a 401(k) withdrawal at 37, before age 59 and a half.
base USD
use std
use us/401k

entity me : person
  born   1988-04-12
  filing single
  lives  us

account assets/checking : bank
account assets/retirement : 401k
  employer acme
account equity/opening

entity acme : employer
  via equity/opening

2025-12-31 equity/opening -> retirement 40_000 USD
2026-02-02 retirement -> checking 10_000 USD
