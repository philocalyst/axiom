// MISTAKE: selling 10 VTI when only 7 are held.
base USD
use std

commodity VTI : fund
  precision 0

account assets/brokerage : broker
account assets/checking : bank
account equity/opening

2025-12-31 equity/opening -> checking 3_000 USD
2026-01-22 checking 2_000 USD -> brokerage 7 VTI
2026-03-02 brokerage 10 VTI -> checking 3_050 USD
