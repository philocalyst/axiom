// MISTAKE: the payment of the card was written backwards (`visa -> checking`), so the
// card statement no longer matches.
base USD
use std

account assets/checking : bank
account liabilities/visa : credit-card
account expenses/food
account equity/opening

2025-12-31 equity/opening -> checking 1_000 USD
2026-01-08 visa -> food 300.00 USD
2026-01-17 visa -> food 152.00 USD
2026-01-25 visa -> checking 200.00 USD
2026-01-31 visa = 252.00 USD
