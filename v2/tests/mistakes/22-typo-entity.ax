// MISTAKE: the payee is `trader-joe`, but the entity is `trader-joes`.
base USD
use std

account assets/checking : bank
account expenses/food/groceries
account expenses/food/dining
account equity/opening

entity trader-joes : org
  via expenses/food/groceries

2025-12-31 equity/opening -> checking 1_000 USD

2026-01-08 checking -> groceries 84.20 USD / trader-joe
