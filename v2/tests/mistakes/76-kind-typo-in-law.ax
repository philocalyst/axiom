// MISTAKE: `wage` for `wages` in a `when` filter.
base USD
use std
use us

entity me : person
  born   1988-04-12
  filing single
  lives  us

account assets/checking : bank
account income/salary : wages
entity acme : employer
  via income/salary

law big-pay
  on in
  when from is wage
  warn amount <= 10_000 USD "a very large paycheck"

2026-01-15 acme -> checking 12_000 USD
