// MISTAKE: `cap[year]` reads a param that nobody declared.
base USD
use std

account assets/checking : bank
account equity/opening
account expenses/food
  law monthly-cap
    on in
    warn total(in, month) <= cap[year] "food is over budget"

2025-12-31 equity/opening -> checking 1_000 USD
2026-01-08 checking -> food 84.20 USD
