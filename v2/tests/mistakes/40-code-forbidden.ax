// MISTAKE: a check number on a card payment; `code check-*` allows it only on
// bank accounts.
base USD
use std

account assets/checking : bank
account liabilities/visa : credit-card
account expenses/food
account equity/opening

entity plumber : org
  via expenses/food

code check-*
  on bank

2025-12-31 equity/opening -> checking 2_000 USD
2026-02-01 visa -> plumber (350 USD) #check-1041
