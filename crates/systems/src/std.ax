/// Standard native kinds and purposes. The v4 roots are built in: `asset`,
/// `debt`, `thing`, `commodity`, `measure`, `entity`, and the four purpose
/// roots. This file declares the shared vocabulary below those roots.
system std

// ─── Accounts ───────────────────────────────────────────────────────────────

kind deposit : asset
kind cash : deposit
kind bank : deposit
  /// A bank balance below zero is an overdraft.
  law overdraft
    always
    warn self.balance >= empty "bank balance below zero"

kind card : debt
kind credit-card : card
kind brokerage : asset
  select fifo
kind escrow : asset
  liquidity 365d
kind loan : debt
  has rate percent optional
  has maturity date optional
  law payoff
    by self.maturity
    require self.balance == empty "balance still owed at maturity"
kind mortgage : loan

kind receivable : asset
  claim
kind payable : debt
  claim

// ─── Identified things ──────────────────────────────────────────────────────

kind thing-owned : thing
kind property : thing
kind personal-use : thing
kind vehicle : personal-use
kind good : thing
kind equipment : thing

// ─── Traded units ────────────────────────────────────────────────────────────

kind currency : commodity
  select fifo
kind security : commodity
kind stock : security
  liquidity 1d
  pays dividend
kind fund : security
  liquidity 2d
  pays dividend
kind bond : security
  liquidity 2d
  pays interest-income
kind crypto : commodity
  liquidity 1d
kind real-estate : commodity
  liquidity 90d

// ─── Common measured units ─────────────────────────────────────────────────

commodity HR : measure
commodity MI : measure
commodity KWH : measure
commodity SQFT : measure

// ─── Shared purposes ────────────────────────────────────────────────────────

purpose food : spending
purpose groceries : food
purpose dining : food
purpose utilities : spending
purpose transport : spending
purpose travel : spending
purpose interest : spending
purpose home : spending
purpose rent : home
purpose phone : home
purpose household : home
purpose fun : spending
purpose insurance : spending
purpose premium : insurance
purpose repair : spending
  of asset
purpose improvement : capital
  of asset
purpose purchase : capital
purpose contribution : transfer
purpose wages : income
purpose pre-tax-deferral : transfer
purpose dividend : income
purpose claim-payout : income
purpose software : spending
purpose streaming : spending
purpose fitness : spending
purpose interest-income : income
purpose gain : capital
purpose tax-paid : spending
purpose federal-tax : tax-paid
purpose state-tax : tax-paid

// ─── Parties ────────────────────────────────────────────────────────────────

kind org : entity
kind merchant : org
kind grocer : merchant
  purpose groceries
kind landlord : org
  purpose rent
kind phone-company : merchant
  purpose phone
kind utility : org
  purpose utilities
kind employer : org
  pays wages
kind government : org
kind tax-authority : government
  purpose tax-paid
kind store : merchant
kind contractor : merchant
kind software : merchant
  purpose software
kind streaming : merchant
  purpose streaming
kind gym : merchant
  purpose fitness
kind insurer : org
  purpose insurance
  pays claim-payout
kind health-insurer : insurer
kind client : org
kind lender : org
kind tenant : org

kind taxpayer : entity
  has filing one of single | joint
  has children number
  children 0
kind person : taxpayer
  has born date optional
  filing single
kind household : taxpayer
  filing joint

kind envelope : entity
  restricted
kind grant : entity
  restricted
  has grant-purpose purpose optional
  has until date optional
  law purpose
    on spend
    require purpose is self.grant-purpose "grant money spent outside its purpose"
  law deadline
    by self.until
    require remaining == empty "grant money left unspent at the deadline"

// ─── Currencies and exchange-file formats ───────────────────────────────────

commodity USD : currency
  name "United States dollar"
  precision 2

commodity EUR : currency
  name "Euro"
  precision 2

commodity GBP : currency
  name "Pound sterling"
  precision 2

commodity CAD : currency
  name "Canadian dollar"
  precision 2

commodity AUD : currency
  name "Australian dollar"
  precision 2

commodity NZD : currency
  name "New Zealand dollar"
  precision 2

commodity CHF : currency
  name "Swiss franc"
  precision 2

commodity SEK : currency
  name "Swedish krona"
  precision 2

commodity NOK : currency
  name "Norwegian krone"
  precision 2

commodity DKK : currency
  name "Danish krone"
  precision 2

commodity PLN : currency
  name "Polish zloty"
  precision 2

commodity CNY : currency
  name "Chinese yuan"
  precision 2

commodity HKD : currency
  name "Hong Kong dollar"
  precision 2

commodity SGD : currency
  name "Singapore dollar"
  precision 2

commodity INR : currency
  name "Indian rupee"
  precision 2

commodity MXN : currency
  name "Mexican peso"
  precision 2

commodity BRL : currency
  name "Brazilian real"
  precision 2

commodity ZAR : currency
  name "South African rand"
  precision 2

commodity JPY : currency
  name "Japanese yen"
  precision 0

commodity KRW : currency
  name "South Korean won"
  precision 0

commodity VND : currency
  name "Vietnamese dong"
  precision 0

commodity ISK : currency
  name "Icelandic krona"
  precision 0

commodity BHD : currency
  name "Bahraini dinar"
  precision 3

commodity KWD : currency
  name "Kuwaiti dinar"
  precision 3

commodity OMR : currency
  name "Omani rial"
  precision 3

commodity JOD : currency
  name "Jordanian dinar"
  precision 3

// ─── Imported statements ───────────────────────────────────────────────────

format ofx
  records STMTTRN
  date DTPOSTED "YYYYMMDD"
  amount TRNAMT
  memo NAME, MEMO
  code CHECKNUM

format camt053
  records Ntry
  date BookgDt/Dt
  amount Amt, sign CdtDbtInd CRDT
  pending Sts PDNG
  memo AddtlNtryInf, RmtInf/Ustrd
  code NtryDtls/TxDtls/RmtInf/Strd/CdtrRefInf/Ref
  via NtryDtls/TxDtls/RltdPties/UltmtCdtr/Nm
