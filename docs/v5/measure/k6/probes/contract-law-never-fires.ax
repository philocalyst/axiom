use std
base USD
entity me : person
entity acme : org
account checking : bank
2025-12-31 market -> checking 9_000 USD
contract lease with acme
  1_000 USD monthly on 1 from checking #rent
  from 2026-01-01
  until 2026-03-31
  law small
    on flow
    warn value(amount, USD) <= 500 USD "too much"
purpose treats : spending
  law toolarge
    on flow
    warn value(amount, USD) <= 50 USD "treat too large"
2026-01-01 lease
2026-02-01 lease
2026-03-01 lease
2026-01-05 checking -> acme 100 USD #treats
