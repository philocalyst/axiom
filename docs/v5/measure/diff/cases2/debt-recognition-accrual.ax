use std
base USD
entity me : person
  books accrual
entity pge : org
account checking : bank
purpose electricity : spending
  law seen
    on flow
    count amount as bills
2026-01-01 market -> checking 1_000 USD
2026-01-05 me owes pge 300 USD due 2026-02-20 #electricity ^b1
2026-01-20 checking -> pge 100 USD ^b1
2026-02-15 ^b1 waived "a credit"
2026-03-01 checking -> pge 50 USD #electricity
