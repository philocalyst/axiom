use std
base USD
entity me : person
entity landlord : org
account checking : bank
account savings : bank
account assets/bank/loan-stuff : bank
asset car : vehicle
asset boat : vehicle
contract lease with landlord
  500 USD monthly on 1 from checking
contract lonely with landlord
  100 USD monthly on 5 from checking
  until 2026-06-30
commodity VTI : stock
commodity GAS : measure

2026-01-01 market -> checking 9_000 USD ^buy1
2026-01-02 checking -> savings 100 USD ^move1
2026-01-03 checking -> landlord 50 USD ^plain
2026-01-04 checking -> market 10 USD

// values
2026-02-01 nowhere = 5 USD
2026-02-01 me = 5 USD
