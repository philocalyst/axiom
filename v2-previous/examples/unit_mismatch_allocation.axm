ledger unit_mismatch_allocation
use personal

party issuer
  name "Northwind Workshop"

party customer
  name "Ada Customer"

2026-07-01 invoice invoice_1
  issuer @issuer
  customer @customer
  amount 100 USD

payment payment_1
  payer @customer
  payee @issuer
  amount 100 EUR
  history [{state:"issued",date:2026-07-02},{state:"presented",date:2026-07-03},{state:"settled",date:2026-07-04}]

allocation allocation_1
  invoice @invoice_1
  payment @payment_1
  amount 100 USD
